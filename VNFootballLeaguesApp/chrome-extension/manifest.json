{
  "manifest_version": 3,
  "name": "VN Football ",
  "version": "1.0",
  "description": "Highlight any football to see information",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:5272/*", "https://vnfootballanalytics.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"]
    }
  ]
}
